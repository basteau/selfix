{
  "name": "selfix",
  "version": "3.0.0",
  "description": "A design-system linter for Nuxt UI: keep Vue components on your theme, tokens, and component props.",
  "keywords": [
    "design-system",
    "lint",
    "linter",
    "nuxt",
    "nuxt-ui",
    "tailwindcss",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basteau/selfix.git",
    "directory": "packages/selfix"
  },
  "bin": {
    "selfix": "./bin/selfix.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build && node scripts/package.mjs"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.0.0 <5",
    "tailwindcss": ">=4.0.0 <5",
    "vue": ">=3.2.13 <4"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
