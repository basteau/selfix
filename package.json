{
  "name": "selfix-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter selfix build",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm --filter playground check && pnpm docs:check",
    "dev": "pnpm build && pnpm --filter playground dev",
    "smoke:package": "node packages/selfix/scripts/smoke-install.mjs",
    "smoke:nuxt": "pnpm build && node packages/selfix/scripts/smoke-nuxt.mjs",
    "release:prepare": "changelogen --dir packages/selfix --output ../../CHANGELOG.md --bump --clean --noAuthors",
    "docs:dev": "pnpm --filter @selfix/docs dev",
    "docs:build": "pnpm --filter @selfix/docs build",
    "docs:preview": "pnpm --filter @selfix/docs preview",
    "docs:check": "pnpm --filter @selfix/docs check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "changelogen": "0.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.23.0"
}
