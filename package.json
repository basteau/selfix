{
  "name": "selfix-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter selfix build",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm --filter playground check",
    "dev": "pnpm build && pnpm --filter playground dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.23.0"
}
